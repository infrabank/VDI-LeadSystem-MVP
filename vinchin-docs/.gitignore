node_modules/

# Mirror of the English source site (large, reproducible via tools/mirror.mjs).
# Keep it OUT of git; it is the input to the build. Re-mirror with: npm run mirror
site/

# Per-run translation batch working files (inputs/outputs). The durable translation
# memory is i18n/strings.ko.json (committed). Batches are regenerated by tools/batch.mjs.
i18n/batches/
i18n/missing.json
i18n/untranslated.json

# Built Korean site (reproducible: npm run mirror && node tools/build.mjs).
# Deploy this folder; it is regenerated by the host build command.
dist/

# Build artifacts / logs
manifest.json
mirror.log
serve.log
_ko_check.html

.vercel
